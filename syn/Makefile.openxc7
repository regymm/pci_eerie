# SPDX-License-Identifier: CERN-OHL-P
# pci_eerie: openXC7 (yosys + nextpnr-xilinx) build of a pcie_7x board top with pci_eerie in
# place of PCIE_2_1.  Run from the repository root, e.g.
#   docker run --rm -u $(id -u):$(id -g) -v $PWD:/mnt regymm/openxc7:timecardflex make -C /mnt -f syn/Makefile.openxc7 [BOARD=..]
# pcie_7x comes from the ext/pcie_7x submodule (PCIE_7X=<path inside the container> to override).
# The nextpnr chip database is generated into syn/chipdb on the first run (CHIPDB to override).
#   BOARD=ac7100b     Alinx AC7100B (xc7a100t, GTP), Gen1   (default)
#   BOARD=ac7100b_msi same board, Gen1, pcie_7x's MSI demo top (pcie_7x_top_aximm_msi)
#   BOARD=ac7100b_x4  Time Card (AC7100B), x4 Gen1: the Vivado 7-series core of the root port
#                     example (from PCIE_EX, path inside the container) with pci_eerie, as
#                     vivado_impl.tcl ac7100b_x4; top syn/top_ac7100b_x4.v
#   BOARD=ypcb_k480t_rp  YPCB K480T root port, x4 (Gen1 by default), PUZHI PZ-SSD lane order, Vivado
#                     core from PCIE_EX as BOARD=ac7100b_x4; bitstream steps as BOARD=ypcb_k480t
#   BOARD=ypcb_k480t  YPCB K480T (xc7k480t, GTX), Gen1, top syn/top_ypcb_k480t.v
#     regymm/openxc7:timecardflex's prjxray-db has no frame addresses for the xc7k480t GT tiles, so
#     run the bitstream steps (target .../top.bit) in an image whose db has them, e.g.
#     openxc7-stable-202608, after the timecardflex run stops at top.frames
BOARD    ?= ac7100b
.DEFAULT_GOAL := all
# a failed step (e.g. fasm2frames writing into a redirect) must not leave a partial target behind
.DELETE_ON_ERROR:
# extra yosys hierarchy parameters, e.g. TOP_PARAMS="-chparam NO_RESET 1"
TOP_PARAMS ?=
# extra synth_xilinx options
SYNTH_FLAGS ?=
DB_DIR   ?= /nextpnr-xilinx/xilinx/external/prjxray-db
CHIPDB   ?= $(CURDIR)/syn/chipdb
PCIE_7X  ?= ext/pcie_7x
SRC      := $(PCIE_7X)/src
ifeq ($(BOARD),ypcb_k480t)
CHIPFAM  := kintex7
PART     := xc7k480tffg1156-2
TOP      := top_ypcb_k480t
BUILDDIR ?= syn/build_openxc7_ypcb_k480t
XDC      := syn/ypcb_k480t_pins.xdc
BOARD_SRC := $(SRC)/pipe_wrapper_gtx.v syn/top_ypcb_k480t.v
else ifeq ($(BOARD),ac7100b_x4)
CHIPFAM  := artix7
PART     := xc7a100tfgg484-2
TOP      := top_ac7100b_x4
BUILDDIR ?= syn/build_openxc7_ac7100b_x4
XDC      := syn/ac7100b_x4_pins.xdc
# nextpnr-xilinx cannot route the SRLC32E cascade output (Q31) yosys uses in the core
SYNTH_FLAGS += -nosrl
else ifeq ($(BOARD),ypcb_k480t_rp)
CHIPFAM  := kintex7
PART     := xc7k480tffg1156-2
TOP      := top_ypcb_k480t_rp
BUILDDIR ?= syn/build_openxc7_ypcb_k480t_rp
XDC      := syn/ypcb_k480t_rp_pzssd_pins.xdc
# Gen1 unless overridden (TOP_PARAMS="-chparam ENABLE_GEN2 1")
TOP_PARAMS := $(if $(TOP_PARAMS),$(TOP_PARAMS),-chparam ENABLE_GEN2 0)
SYNTH_FLAGS += -nosrl
else ifeq ($(BOARD),ac7100b_msi)
CHIPFAM  := artix7
PART     := xc7a100tfgg484-1
TOP      := pcie_7x_top_aximm_msi
BUILDDIR ?= syn/build_openxc7_ac7100b_msi
XDC      := $(PCIE_7X)/pcie_7x_ac7100b.xdc
BOARD_SRC := $(SRC)/pipe_wrapper.v $(SRC)/aximm-minimal/pcie_7x_top_aximm_msi.v $(SRC)/aximm-minimal/axil_minimum_msi.v
else
CHIPFAM  := artix7
PART     := xc7a100tfgg484-1
TOP      := pcie_7x_top_aximm
BUILDDIR ?= syn/build_openxc7
XDC      := $(PCIE_7X)/pcie_7x_ac7100b.xdc
BOARD_SRC := $(SRC)/pipe_wrapper.v
endif
ifeq ($(BOARD),ac7100b_x4)
# Vivado 7-series core (root port example, renamed rp_* -> ep_*, PCIE_2_1 -> pci_eerie), as
# vivado_impl.tcl's vivado_core ep; PCIE_EX: the example imports directory inside the container.
# Its pcie_bram_7x is replaced by syn/oxc_pcie_bram_7x.v (yosys fails on the BRAM_TDP_MACRO copy).
PCIE_EX  ?= ../pcie_7x_0_ex/imports
CORE_EP  := $(BUILDDIR)/pcie_2_1_ep_7x_eerie.v
SOURCES  := $(CORE_EP) syn/oxc_pcie_bram_7x.v tb/eerie_tb_ep_ml.v tb/eerie_tb_app.v syn/eerie_host_app.v syn/top_ac7100b_x4.v \
            $(addprefix rtl/,$(shell cat rtl/files.f))
$(CORE_EP): $(PCIE_EX)/pcie_2_1_rport_7x.v | $(BUILDDIR)
	sed -E 's/\brp_([A-Za-z0-9_]+)\b/ep_\1/g; s/\bpcie_2_1_rport_7x\b/pcie_2_1_ep_7x/g; s/^(\s*)PCIE_2_1 #\(  \/\/ Verilog-2001/\1pci_eerie #(/; s/^module ep_pcie_bram_7x$$/module ep_pcie_bram_7x_vivado/' $< > $@
	test "$$(grep -c '^\s*pci_eerie #(' $@)" = 1
	# nextpnr-xilinx only accepts IBUFDS_GTE2 or nothing on the GTPE2_COMMON reference clock inputs:
	# leave the unused ones open (as pcie_7x's pipe_wrapper.v does)
	sed -E -i '/GTPE2_COMMON #/,/^\s*\);/ s/\.(GTGREFCLK[01]|GTREFCLK1|GTEASTREFCLK[01]|GTWESTREFCLK[01])(\s*)\( *1.d0\)/.\1\2()/' $@
	# nextpnr-xilinx rejects TXPI_SYNFREQ_PPM = 0 (the TX phase interpolator is unused): 1, as pcie_7x
	sed -E -i '/GTPE2_CHANNEL #/,/^\s*\)/ s|//(\.TXPI_SYNFREQ_PPM\s*)\( *3.d0\)|\1( 3'"'"'d1)|' $@
	grep -q "^\s*\.TXPI_SYNFREQ_PPM *( 3'd1)" $@
else ifeq ($(BOARD),ypcb_k480t_rp)
# Vivado root port core with pci_eerie, as vivado_impl.tcl's vivado_core rp (incl. the DBGVECA
# export through pipe_tx_0/1_sigs), its pcie_bram_7x replaced by syn/oxc_pcie_bram_7x.v (renamed rp_)
PCIE_EX  ?= ../pcie_7x_0_ex/imports
CORE_RP  := $(BUILDDIR)/pcie_2_1_rport_7x_eerie.v
BRAM_RP  := $(BUILDDIR)/oxc_pcie_bram_7x_rp.v
SOURCES  := $(CORE_RP) $(BRAM_RP) syn/eerie_host_app.v syn/eerie_host_rp.v syn/top_ypcb_k480t_rp.v \
            $(addprefix rtl/,$(shell cat rtl/files.f))
$(BRAM_RP): syn/oxc_pcie_bram_7x.v | $(BUILDDIR)
	sed 's/\bep_pcie_bram_7x\b/rp_pcie_bram_7x/' $< > $@
$(CORE_RP): $(PCIE_EX)/pcie_2_1_rport_7x.v syn/core_rp_dbg.sed syn/core_oxc_gtx.sed | $(BUILDDIR)
	sed -E 's/^(\s*)PCIE_2_1 #\(  \/\/ Verilog-2001/\1pci_eerie #(/; s/^module rp_pcie_bram_7x$$/module rp_pcie_bram_7x_vivado/' $< > $@
	test "$$(grep -c '^\s*pci_eerie #(' $@)" = 1
	sed -E -i -f syn/core_rp_dbg.sed $@
	# GTXE2_CHANNEL attributes the core leaves at their (unwritten) defaults (syn/core_oxc_gtx.sed)
	sed -E -i -f syn/core_oxc_gtx.sed $@
	grep -q "^\s*\.CPLL_INIT_CFG" $@
	grep -q "gt_cpllpdrefclk = 1.b0" $@
	test "$$(grep -c 'dbg_vec_a_w\|dbg_rst_fsm' $@)" -ge 8
	# unused GT(X/P)E2_COMMON reference clock inputs left open (nextpnr-xilinx: IBUFDS_GTE2 or nothing)
	sed -E -i '/GT[XP]E2_COMMON #/,/^\s*\);/ s/\.(GTGREFCLK[01]?|GTREFCLK1|GTEASTREFCLK[01]|GTWESTREFCLK[01]|GTNORTHREFCLK[01]|GTSOUTHREFCLK[01])(\s*)\( *1.d0\)/.\1\2()/' $@
else
SOURCES  := $(SRC)/xilinx_pcie_mmcm.v $(SRC)/axil_to_al.v $(SRC)/axis_pcie_to_al_us.v $(SRC)/pcie_7x.v \
            $(SRC)/pcie_axi_rx.v $(SRC)/pcie_axi_tx.v $(SRC)/pcie_brams.v $(SRC)/pcie_tx_thrtl_ctl.v \
            $(BOARD_SRC) $(SRC)/aximm-minimal/pcie_7x_top_aximm.v $(SRC)/aximm-minimal/axil_minimum.v \
            integration/pcie_block.v $(addprefix rtl/,$(shell cat rtl/files.f))
endif
LOGFILE  := $(BUILDDIR)/top.log
# nextpnr-xilinx does not pick up the clocks of the board XDC: constrain for the 125 MHz
# PIPE clock of a 2.5 GT/s link so placement and routing are timing driven
# (--freq applies to every clock; the Gen1 user clock only needs 62.5 MHz, so a user_clk
# "FAIL at 125 MHz" is expected: --timing-allow-fail keeps it from aborting, check top.log)
NEXTPNR_FLAGS ?= --freq 125 --timing-allow-fail

all: $(BUILDDIR)/top.bit

$(BUILDDIR):
	mkdir -p $(BUILDDIR)

# -defer: elaborate only what the top instantiates (pcie_7x has GTP and GTX branches);
# $display / $finish in initial blocks (the Vivado core's) are removed before synthesis
$(BUILDDIR)/top.json: $(SOURCES) | $(BUILDDIR)
	yosys -p "read_verilog -defer -Irtl $(SOURCES); hierarchy -top $(TOP) $(TOP_PARAMS); proc; delete t:\$$print t:\$$check; synth_xilinx -flatten -abc9 -arch xc7 $(SYNTH_FLAGS) -top $(TOP); write_json $@" > $(LOGFILE) 2>&1

# chip database for this nextpnr-xilinx build (generated once)
$(CHIPDB)/$(PART).bin:
	mkdir -p $(CHIPDB)
	pypy3 /nextpnr-xilinx/xilinx/python/bbaexport.py --device $(PART) --bba $(CHIPDB)/$(PART).bba
	bbasm -l $(CHIPDB)/$(PART).bba $@
	rm -f $(CHIPDB)/$(PART).bba

$(BUILDDIR)/top.fasm: $(BUILDDIR)/top.json $(CHIPDB)/$(PART).bin
	nextpnr-xilinx $(NEXTPNR_FLAGS) --chipdb $(CHIPDB)/$(PART).bin --xdc $(XDC) --json $< --fasm $@ >> $(LOGFILE) 2>&1

# canonical FASM (one line per set bit) works around fasm parsers that mishandle NAME[hi:lo] = value
$(BUILDDIR)/top.canon.fasm: $(BUILDDIR)/top.fasm
	python3 tools/fasm_canon.py $< > $@

$(BUILDDIR)/top.frames: $(BUILDDIR)/top.canon.fasm
	fasm2frames --part $(PART) --db-root $(DB_DIR)/$(CHIPFAM) $< > $@

$(BUILDDIR)/top.bit: $(BUILDDIR)/top.frames
	xc7frames2bit --part_file $(DB_DIR)/$(CHIPFAM)/$(PART)/part.yaml --part_name $(PART) --frm_file $< --output_file $@ >> $(LOGFILE) 2>&1

clean:
	rm -rf $(BUILDDIR)
